APP_ENV=development

GOOGLE_MAPS_API_KEY=
ANTHROPIC_API_KEY=
AGODA_CID=

# Klook / Travelpayouts
# Tools에서 만든 홈 숏링크 (선택)
KLOOK_AFFILIATE_HOME_URL=
# 검색 URL 래핑 템플릿 — {url} 자리에 인코딩된 destination
# 예: https://tp.media/r?marker=YOUR_MARKER&u={url}
TRAVELPAYOUTS_KLOOK_URL_TEMPLATE=
# 템플릿 없을 때 marker만으로 기본 래핑 (Travelpayouts 파트너 marker)
TRAVELPAYOUTS_MARKER=
# KKday Travelpayouts 홈 숏링크 (eSIM·WiFi 등)
# 예: https://kkday.tpk.lu/I3n5UXqs
KKDAY_AFFILIATE_HOME_URL=
TRAVELPAYOUTS_KKDAY_URL_TEMPLATE=

USE_MOCK_PLACES=true
USE_MOCK_ROUTES=true
USE_MOCK_LLM=true

# Redis 없으면 자동으로 메모리 캐시 사용
CACHE_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_TTL_SECONDS=3600
CACHE_TTL_ROUTES_SECONDS=1800

# 로그인 없는 일정 저장 디렉터리 (Supabase 미설정 시 폴백)
TRIPS_DATA_DIR=data/trips
# 공유 링크 만료(일). 0=무제한
TRIPS_TTL_DAYS=90
# OG 리다이렉트·이미지용 FE origin (배포 시 Netlify URL)
PUBLIC_FRONTEND_URL=http://localhost:5173
# CORS 허용 — 쉼표 구분 (배포 시 Netlify URL 추가)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase (설정 시 trips는 DB 사용, 미설정 시 파일 폴백)
# Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# 서버 전용 — frontend에 넣지 말 것
SUPABASE_SERVICE_ROLE_KEY=
# JWT Secret (Settings → API → JWT Secret) — Bearer 검증
SUPABASE_JWT_SECRET=

# 카카오 OIDC (account_email 없이 로그인) — REST 키 + 로그인용 Client Secret
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
